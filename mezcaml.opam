# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "A minimal nREPL client for OCaml"
description: """
mezcaml is a small, language-agnostic nREPL client library and command-line
tool. It speaks the default nREPL transport (bencode over a TCP socket) and
supports the core protocol operations: clone, describe, eval, load-file,
completions, interrupt and close."""
maintainer: ["Bozhidar Batsov <bozhidar.batsov@gmail.com>"]
authors: ["Bozhidar Batsov <bozhidar.batsov@gmail.com>"]
license: "MIT"
homepage: "https://github.com/nrepl/mezcaml"
bug-reports: "https://github.com/nrepl/mezcaml/issues"
depends: [
  "ocaml" {>= "4.10"}
  "dune" {>= "3.0"}
  "base-unix"
  "dune-build-info"
  "linenoise"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/nrepl/mezcaml.git"
